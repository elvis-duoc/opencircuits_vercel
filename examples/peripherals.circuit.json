  "notes": [
    {
      "id": "c_ac11ec50",
      "x": 50,
      "y": 520,
      "text": "Ejemplo funcional: LCD paralelo e I2C, servo a 90°, cuatro NeoPixel, reloj I2C y ultrasonido a 100 cm. Abre Code y Start Simulation."
    }
  ],
  "programs": {
    "U1": {
      "source": "#include <Servo.h>\n#include <LiquidCrystal.h>\n#include <Adafruit_NeoPixel.h>\n#include <Wire.h>\nServo servo;\nLiquidCrystal lcd(12,11,5,4,3,2);\nAdafruit_NeoPixel strip(4,6,NEO_GRB+NEO_KHZ800);\nvoid backpack(byte value) { Wire.beginTransmission(0x27); Wire.write(value); Wire.endTransmission(); }\nvoid nibble(byte value, bool rs=false) { backpack(value|8|(rs?1:0)|4); delayMicroseconds(2); backpack(value|8|(rs?1:0)); delayMicroseconds(50); }\nvoid lcdByte(byte value, bool rs=false) { nibble(value&0xf0,rs); nibble((value<<4)&0xf0,rs); }\nvoid setup() {\n  Serial.begin(9600); Wire.begin();\n  lcd.begin(16,2); lcd.print(\"Hola circuitos\"); lcd.setCursor(0,1); lcd.print(\"Arduino local\");\n  delay(50); nibble(0x30); delay(5); nibble(0x30); delay(5); nibble(0x30); nibble(0x20);\n  lcdByte(0x28); lcdByte(0x0c); lcdByte(1); delay(2);\n  const char* text=\"LCD por I2C\"; while(*text) lcdByte(*text++,true);\n  Wire.beginTransmission(0x70); Wire.write(0x21); Wire.endTransmission();\n  Wire.beginTransmission(0x70); Wire.write(0x81); Wire.endTransmission();\n  Wire.beginTransmission(0x70); Wire.write(0); byte digits[]={0x06,0,0x5b,0,2,0,0x4f,0,0x66,0}; for(byte n:digits) Wire.write(n); Wire.endTransmission();\n  servo.attach(9); servo.write(90); strip.begin();\n  strip.setPixelColor(0,strip.Color(255,0,0)); strip.setPixelColor(1,strip.Color(0,255,0));\n  strip.setPixelColor(2,strip.Color(0,0,255)); strip.setPixelColor(3,strip.Color(255,180,0)); strip.show();\n  pinMode(7,OUTPUT); pinMode(8,INPUT);\n}\nvoid loop() {\n  digitalWrite(7,LOW); delayMicroseconds(2); digitalWrite(7,HIGH); delayMicroseconds(10); digitalWrite(7,LOW);\n  unsigned long echo=pulseIn(8,HIGH,30000); Serial.print(\"cm=\"); Serial.println(echo/58); delay(100);\n}",
      "mode": "Text"
    }
  }
